generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id               Int       @id @default(autoincrement())
  email            String    @unique
  fName            String
  lName            String
  password         String
  phone            String[]
  hiredAt          DateTime  @default(now())
  address          String
  role             Role
  resetToken       String?
  resetTokenExpiry DateTime?
  driver           Driver?
  trips            Trip[]
}

model Driver {
  id                 Int                 @id
  drivingLicense     String
  avgHealthReadings  AvgHealthReadings[]
  user               User                @relation(fields: [id], references: [id], onDelete: Cascade)
  medicalInformation MedicalInformation?
  trips              Trip[]
  wearableBand       WearableBand?
  vitals              Vitals?
}

model Trip {
  tripId            Int                @id @default(autoincrement())
  startTime         DateTime?
  endTime           DateTime?
  status            tripStatus
  driverId          Int?
  engineId          String?
  fleetManagerId    Int
  plannedStartTime  DateTime
  destLatitude      Float
  destLongitude     Float
  startLatitude     Float
  startLongitude    Float
  alerts            Alert[]
  avgHealthReadings AvgHealthReadings?
  location          Location[]
  towingRequest     TowingRequest?
  driver            Driver?            @relation(fields: [driverId], references: [id])
  car               Car?               @relation(fields: [engineId], references: [engineId])
  fleetManager      User               @relation(fields: [fleetManagerId], references: [id])
}

model Location {
  locationId      Int      @id @default(autoincrement())
  time            DateTime @default(now())
  longitude       Float
  latitude        Float
  tripId          Int
  stoppedAlerts   Alert[]  @relation("AlertStoppedLocation")
  triggeredAlerts Alert[]  @relation("AlertTriggeredLocation")
  trip            Trip     @relation(fields: [tripId], references: [tripId], onDelete: Cascade)
}

model Car {
  engineId String    @id
  plateNo  String
  color    String
  status   carStatus
  trips    Trip[]
}

model HardwareAddOn {
  moduleId            Int     @id @default(autoincrement())
  buzzerStatus        Boolean
  hazardLightStatus   Boolean
  speedControllStatus Boolean
  engineStatus        Boolean
}

model Alert {
  alertId                 Int                      @id @default(autoincrement())
  type                    alertType
  status                  alertStatus
  generatedAt             DateTime                 @default(now())
  solvedAt                DateTime?
  tripId                  Int
  stoppedLocationId       Int?
  triggeredLocationId     Int
  stoppedLocation         Location?                @relation("AlertStoppedLocation", fields: [stoppedLocationId], references: [locationId])
  triggeredLocation       Location                 @relation("AlertTriggeredLocation", fields: [triggeredLocationId], references: [locationId], onDelete: Cascade)
  trip                    Trip                     @relation(fields: [tripId], references: [tripId], onDelete: Cascade)
  emergencyServiceRequest EmergencyServiceRequest?
  healthEvent             HealthEvent?
  towingRequest           TowingRequest?
}

model WearableBand {
  deviceId     Int      @id
  sensorList   String[]
  batteryLevel Int
  isConnected  Boolean
  driverId     Int?     @unique
  driver       Driver?  @relation(fields: [driverId], references: [id])
}

model MedicalInformation {
  recordId     Int           @id @default(autoincrement())
  conditions   String[]
  medications  String[]
  driverId     Int           @unique
  avgHeartRate Float
  avgSpo2      Float
  avgTemp      Float
  maxHeartRate Float
  maxSpo2      Float
  maxTemp      Float
  minHeartRate Float
  minSpo2      Float
  minTemp      Float
  healthEvents HealthEvent[]
  driver       Driver        @relation(fields: [driverId], references: [id], onDelete: Cascade)
  //bloodtype ?
}

model AvgHealthReadings {
  driverId     Int
  avgHeartRate Float
  avgSpo2      Float
  avgTemp      Float
  tripId       Int    @id
  driver       Driver @relation(fields: [driverId], references: [id], onDelete: Cascade)
  trip         Trip   @relation(fields: [tripId], references: [tripId], onDelete: Cascade)
}

model HealthEvent {
  eventId   Int                @id @default(autoincrement())
  eventDate DateTime           @default(now())
  temp      Float
  recordId  Int
  alertId   Int                @unique
  spo2      Float
  heartRate Float
  alert     Alert              @relation(fields: [alertId], references: [alertId], onDelete: Cascade)
  medical   MedicalInformation @relation(fields: [recordId], references: [recordId], onDelete: Cascade)
  guidances FirstAidGuidance[] @relation("FirstAidGuidanceToHealthEvent")
}

model FirstAidGuidance {
  guidanceId     Int               @id @default(autoincrement())
  condition      ConditionType
  severity       ConditionSeverity
  description    String
  specificAction String?
  healthEvents   HealthEvent[]     @relation("FirstAidGuidanceToHealthEvent")

  @@unique([condition, severity])
}

model TowingRequest {
  requestId      Int           @id @default(autoincrement())
  status         requestStatus
  requestTime    DateTime      @default(now())
  completionTime DateTime?
  towingCompany  String
  tripId         Int           @unique
  alertId        Int           @unique
  alert          Alert         @relation(fields: [alertId], references: [alertId], onDelete: Cascade)
  trip           Trip          @relation(fields: [tripId], references: [tripId], onDelete: Cascade)
}

model EmergencyServiceRequest {
  requestId        Int           @id @default(autoincrement())
  status           requestStatus
  requestTime      DateTime      @default(now())
  phone            String
  completionTime   DateTime?
  hospitalAssigned String
  alertId          Int           @unique
  alert            Alert         @relation(fields: [alertId], references: [alertId], onDelete: Cascade)
}

model Vitals {
  id       Int    @id @default(autoincrement())
  driverId Int    @unique
  driver   Driver @relation(fields: [driverId], references: [id], onDelete: Cascade)
  heartRate Float
  spo2      Float
  temp      Float
  createdAt DateTime
}

enum Role {
  ADMIN
  FLEET_MANAGER
  DRIVER
}

enum tripStatus {
  PLANNED
  ONGOING
  CANCELLED
  COMPLETED
}

enum carStatus {
  ACTIVE
  IN_TRIP
  DISABLED
}

enum alertStatus {
  ACTIVE
  RESOLVED
}

enum alertType {
  HEALTH_ABNORMAL
  SOS
}

enum ConditionType {
  LOW_SPO2
  HIGH_HEART_RATE
  LOW_HEART_RATE
  HIGH_TEMP
  LOW_TEMP
}

enum ConditionSeverity {
  MILD
  MODERATE
  CRITICAL
}

enum requestStatus {
  REQUESTED
  INPROGRESS
  COMPLETED
}
