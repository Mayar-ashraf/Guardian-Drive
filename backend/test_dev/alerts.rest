### ─────────────────────────────────────────
### ALERTS — UPDATE
### ─────────────────────────────────────────

### Update stoppedLocationId (car has stopped)
PATCH http://localhost:3000/api/alerts/1
Content-Type: application/json
Authorization: Bearer FLEET_MANAGER_TOKEN

{
    "stoppedLocationId": 2
}

########

### Resolve alert — all checks pass
PATCH http://localhost:3000/api/alerts/1
Content-Type: application/json
Authorization: Bearer FLEET_MANAGER_TOKEN

{
    "status":            "RESOLVED",
    "stoppedLocationId": 2
}

########

### Resolve alert — no stoppedLocationId (should 400)
PATCH http://localhost:3000/api/alerts/2
Content-Type: application/json
Authorization: Bearer FLEET_MANAGER_TOKEN

{
    "status": "RESOLVED"
}

########

### Resolve already resolved alert (should 400)
PATCH http://localhost:3000/api/alerts/1
Content-Type: application/json
Authorization: Bearer FLEET_MANAGER_TOKEN

{
    "status": "RESOLVED"
}

########

### Driver tries to update alert (should 403)
PATCH http://localhost:3000/api/alerts/1
Content-Type: application/json
Authorization: Bearer DRIVER_TOKEN

{
    "status": "RESOLVED"
}

########

### Send empty body (should 400 — at least one field required)
PATCH http://localhost:3000/api/alerts/1
Content-Type: application/json
Authorization: Bearer FLEET_MANAGER_TOKEN

{}



