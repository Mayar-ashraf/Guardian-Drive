### ─────────────────────────────────────────
### FIRST AID GUIDANCE — CREATE
### ─────────────────────────────────────────

### Create guidance — valid (no steps)
POST http://localhost:3000/api/first-aid-guidance
Content-Type: application/json
Authorization: Bearer FLEET_MANAGER_TOKEN

{
    "condition":   "HIGH_HEART_RATE",
    "severity":    "MILD",
    "description": "Heart rate slightly above driver's normal range"
}

########

### Create guidance — valid (with existing stepIds)
POST http://localhost:3000/api/first-aid-guidance
Content-Type: application/json
Authorization: Bearer FLEET_MANAGER_TOKEN

{
    "condition":   "HIGH_HEART_RATE",
    "severity":    "MODERATE",
    "description": "Heart rate significantly elevated above driver's normal range",
    "stepIds": [1, 2, 3]
}

########

### Create guidance — duplicate condition + severity (should 409)
POST http://localhost:3000/api/first-aid-guidance
Content-Type: application/json
Authorization: Bearer FLEET_MANAGER_TOKEN

{
    "condition":   "HIGH_HEART_RATE",
    "severity":    "MILD",
    "description": "Another mild heart rate guidance"
}

########

### Create guidance — invalid condition enum (should 400)
POST http://localhost:3000/api/first-aid-guidance
Content-Type: application/json
Authorization: Bearer FLEET_MANAGER_TOKEN

{
    "condition":   "INVALID_CONDITION",
    "severity":    "MILD",
    "description": "Some description"
}

########

### Create guidance — stepId doesn't exist (should 404)
POST http://localhost:3000/api/first-aid-guidance
Content-Type: application/json
Authorization: Bearer FLEET_MANAGER_TOKEN

{
    "condition":   "LOW_TEMP",
    "severity":    "MILD",
    "description": "Body temperature slightly below normal",
    "stepIds": [9999]
}

########

### Create guidance — driver tries to create (should 403)
POST http://localhost:3000/api/first-aid-guidance
Content-Type: application/json
Authorization: Bearer DRIVER_TOKEN

{
    "condition":   "HIGH_TEMP",
    "severity":    "MILD",
    "description": "Some description"
}

